# arc42 Kap. 4 – Lösungsidee: Datenfluss von der Zulieferquelle bis zum Pass (ST-x = Strategie aus Kap. 4)
...@_stil.d2
# dagre statt ELK: setzt Nutzer und Resolver neben die Pass-Auslieferung statt ganz nach oben
vars: {d2-config: {layout-engine: dagre}}
direction: down

quellen: "Zulieferquellen\nAPI · PDF · CSV · Formular" {class: extern}
nutzer: "Öffentlichkeit · Werkstatt\nRecycler · Behörde" {class: person}

voltpass: "VoltPass" {
  class: container

  eingang: "① Eingang\n(Adapter je Kanal)\nST-2" {class: baustein}
  extraktion: "② KI-Extraktion\n(Vorschlag + Quelle)\nST-1" {class: baustein}
  freigabe: "③ Prüfung & Freigabe\n(Mensch)\nST-1" {class: baustein}
  register: "④ Pass-Register\n(versioniert, append-only)\nST-4" {class: baustein; shape: cylinder}
  zugriff: "⑤ Pass-Auslieferung\n(Feldfilter je Rolle)\nST-5 · ST-7" {class: baustein}
  export: "⑥ Export\n(offenes Format, signiert)\nST-6" {class: baustein}

  eingang -> extraktion -> freigabe -> register
  register -> zugriff
  register -> export
}

resolver: "Resolver\n(stabile QR-URL)\nST-3" {class: system}
treu: "Treuhänder\n(Annahme A-3)" {class: annahme}

quellen -> voltpass.eingang
nutzer -> resolver: "QR-Code scannen"
resolver -> voltpass.zugriff: "leitet weiter"
voltpass.export -> treu: "signierte Kopie"
resolver -> treu: "Umleitung bei\nWegfall VoltCell" {style.stroke-dash: 5}
