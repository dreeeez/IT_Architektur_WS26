# Gemeinsamer Stil für alle Diagramme (per ...@_stil.d2 importieren)
vars: {
  d2-config: {
    layout-engine: elk
    sketch: true
    pad: 48
    # Theme-Farben überschreiben: B1 = Linien/Pfeile, N2 = Linienbeschriftung
    theme-overrides: {
      B1: "#475569"
      N2: "#475569"
    }
  }
}

classes: {
  system: {
    style: {fill: "#4f46e5"; stroke: "#3730a3"; font-color: "#ffffff"; border-radius: 16; font-size: 22; bold: true; shadow: true}
  }
  container: {
    style: {fill: "#f8fafc"; stroke: "#6366f1"; stroke-width: 2; border-radius: 16; font-size: 22; bold: true; font-color: "#1e1b4b"}
  }
  person: {
    shape: person
    width: 70
    height: 80
    style: {fill: "#e0e7ff"; stroke: "#6366f1"; font-color: "#0f172a"}
  }
  extern: {
    style: {fill: "#ffffff"; stroke: "#94a3b8"; border-radius: 12; font-color: "#0f172a"; shadow: true}
  }
  annahme: {
    style: {fill: "#ffffff"; stroke: "#94a3b8"; stroke-dash: 5; border-radius: 12; font-color: "#64748b"}
  }
  baustein: {
    style: {fill: "#eef2ff"; stroke: "#818cf8"; border-radius: 12; font-color: "#1e1b4b"; shadow: true}
  }
}
